<Window x:Class="TVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVideo"
        mc:Ignorable="d"
        Title="TVideo"
        WindowStartupLocation="CenterScreen"
        MinHeight="400"
        Height="450"
        MinWidth="600"
        Width="800"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Button Width="200"
                Height="50"
                Content="Select (info)"
                Click="Button1_Click" />

        <Button Grid.Row="1"
                Width="200"
                Height="50"
                Content="Select (convert)"
                Click="Button2_Click" />
    </Grid>
</Window>
