<Window x:Class="TVideo.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVideo"
        mc:Ignorable="d"
        Title="TVideo"
        WindowStartupLocation="CenterScreen"
        MinHeight="400"
        Height="450"
        MinWidth="600"
        Width="800"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="100" />
            <Setter Property="Width" Value="100" />
            <Setter Property="Margin" Value="10,10,0,10" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource ControlButtonStyle}" Click="ConvertButton_Click">
                <TextBlock TextAlignment="Center" FontSize="16">
                    Select
                    <LineBreak />
                    file
                </TextBlock>
            </Button>

            <Button Style="{StaticResource ControlButtonStyle}" Click="ConvertButton_Click">
                <TextBlock TextAlignment="Center" FontSize="16">
                    Select
                    <LineBreak />
                    folder
                </TextBlock>
            </Button>

            <Button Style="{StaticResource ControlButtonStyle}" Click="MediaButton_Click">
                <TextBlock TextAlignment="Center" FontSize="16">
                    Get
                    <LineBreak />
                    info
                </TextBlock>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
            <TextBlock x:Name="ProgressTextBlock"
                       Margin="10"
                       FontSize="16" />
            <TextBlock x:Name="OutputTextBlock"
                       Margin="10,0,10,10"
                       FontSize="16"
                       Visibility="Collapsed" />
        </StackPanel>

        <ProgressBar x:Name="ProcessProgressBar"
                     Grid.Row="2"
                     Height="32"
                     HorizontalAlignment="Stretch" />
    </Grid>
</Window>
