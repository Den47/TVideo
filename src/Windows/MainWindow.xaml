<Window x:Class="TVideo.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVideo"
        mc:Ignorable="d"
        Title="TVideo – FFmpeg GUI"
        WindowStartupLocation="CenterScreen"
        MinHeight="400"
        Height="400"
        MinWidth="600"
        Width="600"
        Closing="Window_Closing">
    <Grid Background="Transparent"
          AllowDrop="{Binding IsEnabled, ElementName=ControlPanel}"
          PreviewDragOver="FileDropArea_DragOver"
          PreviewDrop="FileDropArea_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="ControlPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
                <Style x:Key="ButtonGlyph" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                    <Setter Property="FontSize" Value="24" />
                    <Setter Property="Foreground" Value="#30343B" />
                    <Setter Property="Height" Value="24" />
                    <Setter Property="Width" Value="24" />
                    <Setter Property="Margin" Value="10" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="TextAlignment" Value="Center" />
                </Style>
            </StackPanel.Resources>

            <Button Click="SelectFileButton_Click">
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE8B2;" />
                    <TextBlock VerticalAlignment="Center" Text="Convert File" />
                </StackPanel>
            </Button>

            <Button Click="SelectFilesButton_Click">
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xED25;" />
                    <TextBlock VerticalAlignment="Center" Text="Convert Files" />
                </StackPanel>
            </Button>

            <Button Click="MediaButton_Click">
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE946;" />
                    <TextBlock VerticalAlignment="Center" Text="Get Info" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="&#xE8C8;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="24"
                       Foreground="#707780"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="Drop one or more MKV files here"
                       VerticalAlignment="Center"
                       Foreground="#707780"
                       FontSize="16" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom">
            <TextBlock x:Name="ProgressTextBlock"
                       Margin="10"
                       FontSize="16"
                       Text="Ready!" />
            <StackPanel x:Name="OutputPanel"
                        Margin="10,0,10,10"
                        Visibility="Collapsed">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock x:Name="CurrentFileTextBlock" Text="Current File: —"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ProcessedTextBlock" Text="Processed: — / —" />
                <TextBlock x:Name="OutputSizeTextBlock" Text="Output Size: —" />
                <TextBlock x:Name="TimeRemainingTextBlock" Text="Time Remaining: —" />
            </StackPanel>
        </StackPanel>

        <ProgressBar x:Name="ProcessProgressBar"
                     Grid.Row="3"
                     Height="32"
                     HorizontalAlignment="Stretch" />
    </Grid>
</Window>
