<Window x:Class="TVideo.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVideo"
        mc:Ignorable="d"
        Title="TVideo"
        WindowStartupLocation="CenterScreen"
        MinHeight="400"
        Height="450"
        MinWidth="600"
        Width="800"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="124" />
            <Setter Property="Width" Value="124" />
            <Setter Property="Margin" Value="10" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource ControlButtonStyle}"
                    Content="Select (info)"
                    Click="Button1_Click" />

            <Button Style="{StaticResource ControlButtonStyle}"
                    Content="Select (convert)"
                    Click="Button2_Click" />
        </StackPanel>

        <TextBlock x:Name="InfoTextBlock"
                   Grid.Row="1"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="10"
                   FontSize="16" />

        <ProgressBar x:Name="ProcessProgressBar"
                     Grid.Row="2"
                     Height="32"
                     HorizontalAlignment="Stretch" />
    </Grid>
</Window>
