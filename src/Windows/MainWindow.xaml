<Window x:Class="TVideo.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVideo"
        mc:Ignorable="d"
        Title="TVideo"
        WindowStartupLocation="CenterScreen"
        MinHeight="400"
        Height="400"
        MinWidth="600"
        Width="600"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="ControlPanel" Orientation="Horizontal">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Width" Value="145" />
                    <Setter Property="Margin" Value="10,10,0,10" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
                <Style TargetType="Image">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Margin" Value="10" />
                    <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                </Style>
            </StackPanel.Resources>

            <Button Click="MediaButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/info.png"/>
                    <TextBlock VerticalAlignment="Center" Text="Get info" />
                </StackPanel>
            </Button>

            <Button Click="SelectFileButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/file.png"/>
                    <TextBlock VerticalAlignment="Center" Text="Convert file" />
                </StackPanel>
            </Button>

            <Button Click="SelectFolderButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/folder.png"/>
                    <TextBlock VerticalAlignment="Center" Text="Convert files" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
            <TextBlock x:Name="ProgressTextBlock"
                       Margin="10"
                       FontSize="16" />
            <TextBlock x:Name="OutputTextBlock"
                       Margin="10,0,10,10"
                       FontSize="12"
                       Visibility="Collapsed" />
        </StackPanel>

        <ProgressBar x:Name="ProcessProgressBar"
                     Grid.Row="2"
                     Height="32"
                     HorizontalAlignment="Stretch" />
    </Grid>
</Window>
