<Window x:Class="TVideo.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVideo"
        xmlns:classes="clr-namespace:TVideo.Windows.Classes"
        mc:Ignorable="d"
        Title="Setup"
        x:Name="SetupDialog"
        WindowStartupLocation="CenterScreen"
        MinHeight="400"
        Height="600"
        MinWidth="400"
        Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView ItemsSource="{Binding Items}"
                  HorizontalContentAlignment="Stretch"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type classes:SetupItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding Language}"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   MinWidth="40"
                                   TextDecorations="None"
                                   Margin="8,4,8,0"
                                   VerticalAlignment="Top" />

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding}"
                                   Margin="0,4,8,0"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   TextDecorations="{Binding IsChecked, ElementName=RemoveButton, Converter={StaticResource StrikethroughConverter}}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Top" />

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="0,-4,0,4">
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="Margin" Value="0,0,8,0" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="{Binding Info.CodecType}" />
                            <TextBlock Text="{Binding Info.CodecName}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Grid.RowSpan="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0"
                                    Visibility="{Binding DataContext.CanProcess, ElementName=SetupDialog, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ToggleButton Padding="10,0"
                                          Margin="0"
                                          Background="Transparent"
                                          BorderThickness="1"
                                          Content="convert"
                                          Visibility="{Binding IsAudio, Converter={StaticResource BoolToVisibilityConverter}}"
                                          IsChecked="{Binding Convert, Mode=TwoWay}" />
                            <ToggleButton x:Name="RemoveButton"
                                          Padding="6"
                                          Margin="6,0,6,0"
                                          Background="Transparent"
                                          BorderThickness="1"
                                          VerticalAlignment="Top"
                                          Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibilityConverter}}"
                                          Checked="ToggleButton_Checked"
                                          Unchecked="ToggleButton_Checked">
                                <Viewbox Width="14" Height="14">
                                    <Path Data="M0,0 L16,16 M16,0 L0,16"
                                          Stroke="Red"
                                          StrokeThickness="1"
                                          Width="16"
                                          Height="16"/>
                                </Viewbox>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10"
                    Visibility="{Binding CanProcess, Converter={StaticResource BoolToVisibilityConverter}}">
            <CheckBox VerticalAlignment="Center"
                      FontSize="16"
                      IsChecked="{Binding ApplyToAll, Mode=TwoWay}"
                      Visibility="{Binding MultiSelect, Converter={StaticResource BoolToVisibilityConverter}}"
                      Content="Apply to all" />
            <Button Content="Run"
                    Margin="20,0,0,0"
                    Height="40"
                    Width="80"
                    FontSize="16"
                    Click="RunButton_Click" />
        </StackPanel>
    </Grid>
</Window>
