<Window x:Class="TVideo.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVideo"
        xmlns:classes="clr-namespace:TVideo.Windows.Classes"
        mc:Ignorable="d"
        Title="Setup"
        x:Name="SetupDialog"
        WindowStartupLocation="CenterScreen"
        MinHeight="400"
        Height="600"
        MinWidth="400"
        Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView ItemsSource="{Binding Items}"
                  HorizontalContentAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type classes:SetupItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Rectangle HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Height="2"
                                   Width="{Binding ActualWidth, ElementName=TitleStackPanel, Mode=OneWay}"
                                   Fill="Black"
                                   Margin="8,8,0,0"
                                   Visibility="{Binding IsChecked, ElementName=RemoveButton, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <StackPanel x:Name="TitleStackPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="18" />
                                    <Setter Property="FontWeight" Value="Medium" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="{Binding Info.Index}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding}" Margin="14,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Margin" Value="8,0,0,4" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="{Binding Info.CodecType}" />
                            <TextBlock Text="{Binding Info.CodecName}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Grid.RowSpan="2"
                                    Orientation="Horizontal"
                                    Visibility="{Binding DataContext.CanProcess, ElementName=SetupDialog, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ToggleButton Margin="4,4,6,4"
                                          Padding="10"
                                          Background="Transparent"
                                          BorderThickness="1"
                                          Content="convert"
                                          Visibility="{Binding IsAudio, Converter={StaticResource BoolToVisibilityConverter}}"
                                          IsChecked="{Binding Convert, Mode=TwoWay}" />

                            <ToggleButton x:Name="RemoveButton"
                                          Margin="4"
                                          Padding="10"
                                          Background="Transparent"
                                          BorderThickness="1"
                                          Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibilityConverter}}"
                                          Checked="ToggleButton_Checked"
                                          Unchecked="ToggleButton_Checked">
                                <Path Data="M0,0 L16,16 M16,0 L0,16"
                                      Stroke="Red"
                                      StrokeThickness="1"
                                      Width="16"
                                      Height="16"/>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10"
                    Visibility="{Binding CanProcess, Converter={StaticResource BoolToVisibilityConverter}}">
            <CheckBox VerticalAlignment="Center"
                      FontSize="16"
                      IsChecked="{Binding ApplyToAll, Mode=TwoWay}"
                      Visibility="{Binding MultiSelect, Converter={StaticResource BoolToVisibilityConverter}}"
                      Content="Apply to all" />
            <Button Content="Run"
                    Margin="20,0,0,0"
                    Height="40"
                    Width="80"
                    FontSize="16"
                    Click="RunButton_Click" />
        </StackPanel>
    </Grid>
</Window>
